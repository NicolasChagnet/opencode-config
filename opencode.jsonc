{
  "$schema": "https://opencode.ai/config.json",
  "model": "lightweight",
  // Research agents may use only explicitly granted external MCP tools;
  // local repository work remains with the caller or Cartographer.
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/oauth",
      "enabled": true
    },
    "paper-search": {
      "type": "local",
      "command": ["uvx", "paper-search-mcp"]
    },
    "arxiv": {
      "type": "local",
      "command": ["uvx", "arxiv-mcp-server"]
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {file:.github_token}"
      }
    },
    "github-readonly": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {file:.github_token}",
        "X-MCP-Tools": "get_file_contents,search_code,get_repository_tree",
        "X-MCP-Readonly": "true"
      }
    }
  },
  "agent": {
    // All built-in agents disabled; custom naval agents replace them.
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "scout": {
      "disable": true
    }
  },
  "command": {
    "ask-code": {
      "description": "Answers questions about the codebase",
      "agent": "cartographer",
      "template": "Answer the user question using all the tools at your disposal: Question: $ARGUMENTS"
    },
    "ask-info": {
      "description": "Answers questions about documentation, API and general knowledge",
      "agent": "navigator",
      "template": "Answer the user question using all the tools at your disposal: Question: $ARGUMENTS"
    },
    "fix-all": {
      "description": "Run linter and tests, fix all errors",
      "agent": "frigate",
      "template": "1. Run the project-defined linters. Fix all errors you find.\n2. Run the project test suite. For failing tests, consider whether the codebase or the test suite drifted, and suggest appropriate fixes."
    },
    "describe": {
      "description": "Add a description to the current revision",
      "agent": "frigate",
      "template": "Write a description for the current jujutsu revision using `jj desc -m \"DESCRIPTION\"`.\nBase that description from the user input (OPTION): \"$1\"\nand from the diff of the current revision accessible via `jj diff -f @- -t @ --git --no-pager`\n\nDo not use the user input verbatim (it's a guideline). Focus on the why, not the what!\nUse conventional commits."
    },
    "plannotator-annotate": {
      "description": "Open interactive annotation UI for a file, folder, or URL",
      "template": ""
    },
    "plannotator-last": {
      "description": "Annotate the last assistant message",
      "template": ""
    },
    "plannotator-review": {
      "description": "Open interactive code review for current changes or a PR URL; pass --git or --gitbutler to force that provider",
      "template": ""
    },
    "split": {
      "description": "Split a large change into mutliple consistent changes",
      "agent": "frigate",
      "template": "Using the jujutsu VCS, split the current revision into self-consistent changes using `jj split`.\nDo not just split per file, instead follow this plan:\n\n1. Summarize all changes in the revision.\n2. Estimate how many clusters of changes there are: this will be the final number of revisions.\n3. Assign each change to a cluster, inside its own jujutsu revision, by recursively splitting."
    },
    "update-instructions": {
      "description": "Generate or update the nearest applicable AGENTS.md.",
      "agent": "frigate",
      "template": "Create or update the nearest applicable AGENTS.md for this project. First inspect the current project structure, development tooling, conventions, and existing AGENTS.md files. Preserve accurate existing guidance; do not overwrite user-authored rules without explaining the conflict. Record only durable facts: project structure, development guidelines/style, and recurring user preferences. Keep it concise and actionable. Validate every documented command or path when practical. If scope is unclear, ask whether to update the repository root AGENTS.md or a nested one. User request: $ARGUMENTS"
    }
  },
  "default_agent": "jack",
  "subagent_depth": 2,
  // Fine-tune tool permissions per agent
  "permission": {
    "context7_*": "deny",
    "paper-search_*": "deny",
    "arxiv_*": "deny",
    "codegraph_*": "deny",
    "github_*": "deny",
    "github-readonly_*": "deny",
    "skill": {
      "*": "deny"
    },
    "external_directory": {
      "/tmp/": "allow",
      "~/.plannotator": "allow"
    },
    "question": "allow"
  },
  "plugin": [
    "@dietrichgebert/ponytail",
    "./plugins/opencode-model-alias/src/index.ts",
    ["./plugins/plan-tools/src/index.ts", {
      "approval_agent": "fleet"
    }]
  ]
}
